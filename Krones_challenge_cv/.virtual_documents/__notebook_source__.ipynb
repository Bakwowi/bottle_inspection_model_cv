def install_packages(packages: list[str]) -> None:
    """Install pip packages quietly."""
    for pkg in packages:
        subprocess.check_call(
            [sys.executable, '-m', 'pip', 'install', '-q', pkg],
            stdout=subprocess.DEVNULL,
        )

